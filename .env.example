# Telegram Alerts Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_THREAD_ID=
TELEGRAM_ENABLED=true

# Scanner Parameters (Optional overrides)
MIN_24H_QUOTE_VOLUME=250000
COOLDOWN_MINUTES=180
DATABASE_PATH=scanner_data.db

# WEEX Trade Execution (V3 Contract API)
# Set WEEX_ENABLED=true to enable automatic translation of MEXC alerts into WEEX trades
WEEX_ENABLED=false
WEEX_DRY_RUN=true
WEEX_API_KEY=your_weex_api_key_here
WEEX_API_SECRET=your_weex_api_secret_here
WEEX_PASSPHRASE=your_weex_passphrase_here
WEEX_BASE_URL=https://api-contract.weex.com
WEEX_LEVERAGE=3
WEEX_POSITION_SIZE_PCT=0.10
# WEEX_FIXED_ORDER_USDT=50.0  # Optional fixed USDT order size
